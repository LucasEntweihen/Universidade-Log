# ==============================================================================
# UNIVERSIDADE LOG — REGRAS DE IGNORE DO GIT (.GITIGNORE)
# ==============================================================================

# Dependências do passo de build (npm install / yarn / pnpm) — regeneráveis,
# não devem ser versionadas no repositório.
node_modules/
.pnpm-store/

# Saída de compilação e builds de produção (npm run build / Vercel / Next / Dist)
dist/
build/
.vercel/
.output/
.turbo/
.next/

# Segredos, Chaves de API e Variáveis de Ambiente (.env)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.pem
*.key

# Cache, Arquivos Compilados e Ambientes Virtuais de Python (FastAPI / LangChain / RAG)
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
ENV/
env/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Logs de execução e depuração
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Arquivos temporários de sistema e editores (OS / IDE)
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini
*.swp
*.swo
*~
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
