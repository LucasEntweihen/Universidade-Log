# EditorConfig ajuda a manter um estilo consistente entre editores.
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# CHANGELOG.md é escrito à mão; preserva espaços intencionais de formatação
[*.md]
trim_trailing_whitespace = false

# Favicons/ícones binários — não se aplica formatação de texto
[*.{ico,png,svg}]
insert_final_newline = false
